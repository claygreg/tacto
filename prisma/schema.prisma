// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// NextAuth.js Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  provider      String    @default("email")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  classrooms      Classroom[]
  questions       Question[]
  tests           Test[]
  folders         QuestionFolder[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Application Models
model Classroom {
  id        String   @id @default(cuid())
  name      String
  year      String?
  subject   String?
  archived  Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students    Student[]
  testAssignments TestAssignment[]
}

model Student {
  id           String   @id @default(cuid())
  fullName     String
  cpf          String?
  enrollmentId String?
  email        String?
  birthDate    DateTime?
  classroomId  String
  classroom    Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  submissions StudentSubmission[]
}

model Question {
  id          String   @id @default(cuid())
  type        String   // 'multiple_choice', 'discursive'
  body        String   
  baseText    String?  
  discipline  String?
  tags        String?  // Stored as JSON string in SQLite
  bnccCode    String?
  yearLevel   String?
  difficulty  String?  // 'easy', 'medium', 'hard'
  source      String   @default("personal") // 'personal', 'public', 'ai_generated'
  imageUrl    String?  // Armazenará a URL direta da imagem (ex: INEP)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  options         QuestionOption[]
  testQuestions   TestQuestion[]
  results         QuestionResult[]
  folderItems     FolderQuestion[]
}

model QuestionOption {
  id         String   @id @default(cuid())
  label      String   // 'A', 'B', 'C', 'D', 'E'
  text       String   
  isCorrect  Boolean  @default(false)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// ── Tests & Assessments ──────────────────────────────────────

model Test {
  id           String   @id @default(cuid())
  title        String
  instructions String?
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  questions    TestQuestion[]
  assignments  TestAssignment[]
}

model TestQuestion {
  id             String   @id @default(cuid())
  testId         String
  questionId     String
  order          Int
  weight         Float    @default(1.0)

  test           Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model TestAssignment {
  id          String    @id @default(cuid())
  testId      String
  classroomId String
  appliedAt   DateTime?
  
  test        Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  submissions StudentSubmission[]
}

model StudentSubmission {
  id               String         @id @default(cuid())
  testAssignmentId String
  studentId        String
  version          String         @default("A") // 'A', 'B', 'C'
  totalScore       Float?
  appliedAt        DateTime?

  testAssignment   TestAssignment @relation(fields: [testAssignmentId], references: [id], onDelete: Cascade)
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  results          QuestionResult[]
}

model QuestionResult {
  id                  String             @id @default(cuid())
  studentSubmissionId String
  questionId          String             
  selectedOption      String?
  isCorrect           Boolean?
  scoreObtained       Float?
  manualScore         Float?

  studentSubmission   StudentSubmission  @relation(fields: [studentSubmissionId], references: [id], onDelete: Cascade)
  question            Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// ── Question Folders ─────────────────────────────────────────

model QuestionFolder {
  id        String   @id @default(cuid())
  name      String
  color     String?  // hex color for visual identification
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions FolderQuestion[]
}

model FolderQuestion {
  folderId   String
  questionId String
  addedAt    DateTime @default(now())

  folder   QuestionFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  question Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([folderId, questionId])
}
